# MacinDecode-AC4-Core 外部工具路径模板。
#
# 复制为 .env.local 后按本机情况填写。.env.local 不进入版本控制。
# 这些工具只属于开发期的测试向量生产链，解码核心本身不依赖其中任何一项。
#
#   cp .env.local.example .env.local
#   ./scripts/check_tools.sh
#   ./scripts/check_tools.sh --profile all  # 同时校验 DME A-JOC 与 DEE IMS 链
#
# 所有条目均按不透明工具对待：本项目只约定其输入、输出与版本指纹。

# --- 必需 ---

# DAMF -> ADM BWF 的规范化工具
ADM_NORMALIZER=""

# ADM BWF -> AC-4 的编码工具
AC4_ENCODER=""

# 上述编码工具的源仓库根目录，用于记录 provenance 所需的 commit 与工作树状态。
# 若该工具不由源码构建则留空。
AC4_ENCODER_REPO=""

# 编码工具所需的本地后端组件。留空表示该工具自包含，无需额外校验。
AC4_ENCODER_BACKEND=""

# --- 可选：DME AC-4 A-JOC ---

# DME 安装内的 dee_ac4ajoc_encoder 与同版本 dee_mp4muxer。前者在普通模式读取
# 规范化 ADM BWF，在 3DoF 模式读取隔离生成的 DAMF 0.6.0，并输出 raw AC-4/timing
# manifest；后者按 manifest 原子封装为 M4A。
DME_AC4_AJOC_ENCODER=""
DME_MP4MUXER=""

# --- 可选：DEE immersive stereo AC-4 ---

# DEE CLI 或把其工作区映射为 Windows drive 的本机包装器。
DEE_ENCODER=""

# 实际 DEE engine binary；只读取 SHA-256 作为 provenance 指纹，不直接执行。
DEE_ENGINE_BINARY=""

# 官方 damf_encode_to_ims_ac4.xml（output 必须是 raw AC-4，而不是 MP4）。
DEE_IMS_TEMPLATE=""

# 包装器对 DEE 可见的可写 host 根目录，以及它映射到的 Windows drive。
# build_vector.sh 只在该目录下创建并自动清理 tmp_macinac4_ims.* staging。
DEE_WORKSPACE_ROOT=""
DEE_WORKSPACE_DRIVE="y:"

# --- M1 交叉核对 ---

# cross_check.sh 必需；留空时从 PATH 查找。
FFPROBE=""
MP4INFO=""   # Bento4 mp4info
MEDIAINFO=""

# GPAC MP4Box。DEE IMS profile 用它把 raw AC-4 封装为 M4A；标准编码器产物含
# 辅助视频轨时也用它做无损移除。留空时从 PATH 查找。
MP4BOX=""

# --- 可选 ---

# 测试向量产物根目录；留空则使用仓库内 ./vectors
VECTORS_DIR=""
